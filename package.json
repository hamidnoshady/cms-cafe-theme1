{
  "name": "coffee-shop-eshobe-theme",
  "version": "1.0.0",
  "private": true,
  "description": "The original coffee-menu poster, rendered from Eshobe CMS contract v1.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "PORT=3000 HOST=0.0.0.0 sh -c 'if [ -z \"$ESHOBE_CMS_URL\" ] && ! grep -qE \"^ESHOBE_CMS_URL=.+\" .env 2>/dev/null; then export DEMO_MODE=true; fi; exec node --env-file-if-exists=.env server.js'",
    "build": "node scripts/build.mjs",
    "validate:manifest": "node scripts/check.mjs",
    "lint": "node scripts/lint.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "test:browser": "node tests/browser.mjs && node tests/checkout-browser.mjs"
  },
  "dependencies": {
    "@eshobe/site-runtime": "file:vendor/eshobe-site-runtime"
  },
  "devDependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@sparticuz/chromium": "133.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.78.0",
    "playwright-core": "1.51.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
